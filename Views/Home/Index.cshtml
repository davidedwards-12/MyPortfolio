@{
    ViewData["Title"] = "Home";
    ViewData["Description"] = "David Edwards is a software developer building reliable web applications with C#, ASP.NET Core, and modern DevOps practices.";
}
<div class="d-flex justify-content-center align-items-center mt-5">
    <div class="mr-4">
        <img src="~/images/me.jpg" alt="David's Profile Picture" style="width: 250px;" />
    </div>
</div>
<div class="text-center mt-5 py-5">
    <h2 class="display-4 fw-bold">Hi, I am David!</h2>
    <p class="lead mt-4 mx-auto">
        I am a software developer with a Computer Science background from East Tennessee State University.
        I focus on building dependable, user-centered applications with C#, ASP.NET Core, and practical DevOps workflows.
        I enjoy turning ideas into production-ready solutions and continuously sharpening my skills through hands-on projects.
    </p>
    <button class="button" style="vertical-align:middle" onclick="window.location.href='@Url.Action("Contact","Home")'">
        <span>Contact Me</span>
    </button>
</div>
