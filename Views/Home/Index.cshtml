@{
    ViewData["Title"] = "Home";
    ViewData["Description"] = "David Edwards is a software developer building reliable web applications with C#, ASP.NET Core, and modern DevOps practices.";
}

<section class="hero reveal">
    <div class="hero-grid">
        <div class="hero-photo-wrap">
            <img class="hero-photo" src="~/images/me.jpg" alt="Portrait of David Edwards" />
        </div>
        <div class="hero-content">
            <p class="hero-eyebrow">Application Software Engineer</p>
            <h1>Building practical software that people can rely on.</h1>
            <p class="hero-copy">
                I'm a Software Engineer focused on mobile app development, with a Computer Science
                foundation from East Tennessee State University. In my role at Permobil, I build and maintain iOS and
                Android applications using Swift and Kotlin, delivering stable, high-performance experiences that
                integrate with connected hardware.
            </p>
            <p class="hero-copy">
                I also bring experience in C#, .NET, CI/CD, automated testing, Docker, and Agile/Scrum workflows.
                I'm driven by curiosity, clean code, and building software that creates real-world impact.
            </p>
            <div class="hero-actions">
                <a class="btn btn-primary-hero" asp-controller="Home" asp-action="Projects">View Projects</a>
                <a class="btn btn-ghost-hero" asp-controller="Home" asp-action="Contact">Contact Me</a>
            </div>
        </div>
    </div>
</section>
