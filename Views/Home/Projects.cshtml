@{
    ViewData["Title"] = "Projects";
    ViewData["Description"] = "Selected software projects by David Edwards, including full-stack web apps and team-based development work.";
}

<section class="projects-container reveal">
    <h2 class="projects-header">Selected Projects</h2>
    <div class="projects-grid">
    <div class="project-item">
            <div class="project-preview">
            <a href="https://github.com/davidedwards-12/budget-calc-app-ios" target="_blank" rel="noopener noreferrer">
                <img src="~/images/budgetcalc_dashboard.png" class="image-zoom" alt="Dashboard View" />
            </a>
            </div>
            <div class="project-details">
                <h3>StatementSense</h3>
                <p>
                    StatementSense is a native iOS app that lets users import bank statement PDFs and gain a clear picture of their finances.
                    The app parses multi-bank statements, auto-categorizes transactions, and provides monthly spending breakdowns, income vs. expense summaries, and savings rate tracking.
                    Technologies: Swift, SwiftUI, SwiftData, PDFKit, Swift Charts
                </p>
            </div>
        </div>
        <div class="project-item">
            <div class="project-preview">
            <a href="https://github.com/davidedwards-12/MyPortfolio" target="_blank" rel="noopener noreferrer">
                <img src="~/images/portfolio.png" class="image-zoom" alt="My Portfolio Project Thumbnail" />
            </a>
            </div>
            <div class="project-details">
                <h3>My Portfolio</h3>
                <p>
                    This website! My Portfolio is a personal website showcasing my projects, skills, and experience. I designed and developed the site to highlight my work and provide a professional online presence.
                    Technologies: C#, ASP.NET Core, JavaScript.
                </p>
            </div>
        </div>
        <div class="project-item">
            <div class="project-preview">
            <a href="https://github.com/davidedwards-12/SignWizApp" target="_blank" rel="noopener noreferrer">
                <img src="~/images/SignWiz.png" class="image-zoom" alt="SignWiz App Project Thumbnail" />
            </a>
            </div>
            <div class="project-details">
                <h3>SignWiz App</h3>
                <p>
                    SignWiz is an educational app designed to help users learn sign language through quizzes and interactive challenges.
                    Technologies: HTML, C#, CSS, JavaScript.
                </p>
            </div>
        </div>
        <div class="project-item">
            <div class="project-preview">
            <a href="https://github.com/dentij-etsu/BucStop" target="_blank" rel="noopener noreferrer">
                <img src="~/images/BucStop.png" class="image-zoom" alt="BucStop Project Thumbnail" />
            </a>
            </div>
            <div class="project-details">
                <h3>BucStop Project</h3>
                <p>
                    BucStop is a web platform that gave ETSU students classic arcade games to play between classes.
                    I contributed to feature development and built a CI/CD pipeline that automatically tested and built
                    the app with Docker.
                    Technologies: HTML, C#, Python, AWS, Docker, Bash.
                </p>
            </div>
        </div>
        <div class="project-item">
            <div class="project-preview">
            <a href="https://github.com/dentij-etsu/BetterThanBucHunt" target="_blank" rel="noopener noreferrer">
