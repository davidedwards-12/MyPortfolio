---
import Base from '../layouts/Base.astro';
---

<Base title="Privacy" description="Privacy policy for davidedwards.dev.">
  <section class="hero plain prose">
    <p class="label">Privacy</p>
    <h1>Privacy</h1>
    <p>This site does not use cookies, analytics or tracking scripts.</p>
    <p>
      If you use the contact form, the name, email address and message you enter are sent to me through
      <a href="https://web3forms.com" rel="noopener">Web3Forms</a> so that I can reply. I don't share them with
      anyone else or use them for marketing.
    </p>
    <p>To have a message you sent removed, <a href="/#contact">contact me</a>.</p>
  </section>
</Base>
